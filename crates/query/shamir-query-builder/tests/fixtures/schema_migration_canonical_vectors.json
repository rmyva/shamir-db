  "cases": [
    {
      "name": "all-nineteen-operation-kinds",
      "description": "One migration body containing every admitted operation kind across table, index, schema, function and validator families in authored order. Each operation carries language-neutral structured args (DTO field names and exact values, including exact source bytes) that the client tests must reproduce from its typed builders; the expected bytes and checksum pin the whole canonical encoding.",
      "migrations": [
        {
          "id": "id",
          "ordinal": 1,
          "display_name": "n",
          "function_dependencies": [],
          "operations": [
            {
              "family": "table",
              "variant": "create_table",
              "description": "create table t in repo main without if_not_exists, retention or schema",
              "args": {
                "create_table": "t",
                "repo": "main"
              }
            },
            {
              "family": "table",
              "variant": "drop_table",
              "description": "drop table t with if_exists true, cascade false, repo main; hmac tag excluded from canonical bytes",
              "args": {
                "drop_table": "t",
                "repo": "main",
                "if_exists": true
              }
            },
            {
              "family": "table",
              "variant": "rename_table",
              "description": "rename table t to u in repo main",
              "args": {
                "rename_table": "t",
                "to": "u",
                "repo": "main"
              }
            },
            {
              "family": "index",
              "variant": "create_index",
              "description": "create fts index ix on table t over field path [a] with whitespace tokenizer, unique and sorted false, repo main, no include paths",
              "args": {
                "create_index": "ix",
                "table": "t",
                "fields": [
                  [
                    "a"
                  ]
                ],
                "repo": "main",
                "index_type": "fts",
                "fts_tokenizer": "whitespace"
              }
            },
            {
              "family": "index",
              "variant": "drop_index",
              "description": "drop index ix on table t with if_exists true, repo main; hmac and request id excluded",
              "args": {
                "drop_index": "ix",
                "repo": "main",
                "table": "t",
                "if_exists": true
              }
            },
            {
              "family": "index",
              "variant": "rename_index",
              "description": "rename index ix to iy on table t, if_exists false, repo main",
              "args": {
                "rename_index": "ix",
                "to": "iy",
                "table": "t",
                "repo": "main"
              }
            },
            {
              "family": "schema",
              "variant": "set_table_schema",
              "description": "replace schema of table t with an empty rule list, no expected version, repo main",
              "args": {
                "set_table_schema": "t",
                "repo": "main"
              }
            },
            {
              "family": "schema",
              "variant": "add_schema_rule",
              "description": "add rule for path [a] of type f64 with f64 bounds min 1.0 and max negative zero, repo main",
              "args": {
                "add_schema_rule": "t",
                "repo": "main",
                "rule_path": [
                  "a"
                ],
                "rule_type": "f64",
                "rule_min": 1.0,
                "rule_max": -0.0
              }
            },
            {
              "family": "schema",
              "variant": "remove_schema_rule",
              "description": "remove rule at path [a] of table t, repo main",
              "args": {
                "remove_schema_rule": "t",
                "repo": "main",
                "path": [
                  "a"
                ]
              }
            },
            {
              "family": "function",
              "variant": "create_function",
              "description": "register function f from exact source \"fn f() {}\", replace false, defaults resolved to invoker security, rust language, auto optimization; hmac excluded",
              "args": {
                "create_function": "f",
                "source": "fn f() {}"
              }
            },
            {
              "family": "function",
              "variant": "drop_function",
              "description": "drop function f with if_exists true",
              "args": {
                "drop_function": "f",
                "if_exists": true
              }
            },
            {
              "family": "function",
              "variant": "rename_function",
              "description": "rename function f to g",
              "args": {
                "rename_function": "f",
                "to": "g"
              }
            },
            {
              "family": "function",
              "variant": "check_function",
              "description": "admission check of exact source \"fn f() {}\" without storing; language and optimization resolved to defaults rust and auto",
              "args": {
                "check_source": "fn f() {}"
              }
            },
            {
              "family": "function",
              "variant": "alter_function",
              "description": "change optimization mode of function f to never",
              "args": {
                "alter_function": "f",
                "optimize": "never"
              }
            },
            {
              "family": "validator",
              "variant": "create_validator",
              "description": "register validator v from exact source \"fn validate() {}\", replace false; hmac excluded",
              "args": {
                "create_validator": "v",
                "source": "fn validate() {}"
              }
            },
            {
              "family": "validator",
              "variant": "drop_validator",
              "description": "drop validator v with if_exists true",
              "args": {
                "drop_validator": "v",
                "if_exists": true
              }
            },
            {
              "family": "validator",
              "variant": "rename_validator",
              "description": "rename validator v to w",
              "args": {
                "rename_validator": "v",
                "to": "w"
              }
            },
            {
              "family": "validator",
              "variant": "bind_validator",
              "description": "bind validator v to table t of db main-repo for insert and update operations at priority 1500",
              "args": {
                "bind_validator": "v",
                "db": "db",
                "table": "t",
                "repo": "main",
                "ops": [
                  "insert",
                  "update"
                ],
                "priority": 1500
              }
            },
            {
              "family": "validator",
              "variant": "unbind_validator",
              "description": "unbind validator v from table t of db, repo main",
              "args": {
                "unbind_validator": "v",
                "db": "db",
                "table": "t",
                "repo": "main"
              }
            }
          ],
          "expected_canonical_bytes_hex": "",
          "expected_checksum_hex": "fcfcbe95d320ddcde662c4fb23d505e2e8db0d33121b747a14c96c9ba7ef913a"
        }
      ]
    },
    {
      "name": "function-dependency-ordering-is-canonical",
      "description": "Dependency rows are authored out of order and each name list is unsorted; canonical encoding must sort rows by function bytes and each name list likewise, independent of authoring order.",
      "migrations": [
        {
          "id": "dep-order",
          "ordinal": 1,
          "display_name": "dependency sort",
          "function_dependencies": [
            {
              "function": "zeta_fn",
              "depends_on": [
                "b_dep",
                "a_dep"
              ],
              "description": "zeta_fn is replaced by this migration, so its callees b_dep and a_dep must be rechecked during planning"
            },
            {
              "function": "alpha_fn",
              "depends_on": [
                "solo"
              ],
              "description": "alpha_fn registration is introduced by this migration and is planned against its own dependency solo"
            }
          ],
          "operations": [
            {
              "family": "function",
              "variant": "create_function",
              "description": "register function zeta_fn from exact source \"fn zeta_fn() {}\"",
              "args": {
                "create_function": "zeta_fn",
                "source": "fn zeta_fn() {}"
              }
            },
            {
              "family": "validator",
              "variant": "create_validator",
              "description": "register validator alpha_v from exact source \"fn alpha_v() {}\"",
              "args": {
                "create_validator": "alpha_v",
                "source": "fn alpha_v() {}"
              }
            }
          ],
          "expected_canonical_bytes_hex": "",
          "expected_checksum_hex": "0ed3e8d46b65c639740c361e24eae5e40ab30ea43d5a5dc2eb8c0d29785fe4b3"
        }
      ]
    },
    {
      "name": "optional-fields-change-canonical-bytes",
      "description": "Optional fields set explicitly: if_not_exists, retention triple, replace with visibility and optimization overrides, expected schema version, non-default bind operations and priority, drop without if_exists. Every present optional value must change the canonical bytes.",
      "migrations": [
        {
          "id": "optional-fields",
          "ordinal": 1,
          "display_name": "optional fields",
          "function_dependencies": [],
          "operations": [
            {
              "family": "table",
              "variant": "create_table",
              "description": "create table opts_t with if_not_exists true and retention of 3600 second age cap plus minimum count 10, repo main",
              "args": {
                "create_table": "opts_t",
                "repo": "main",
                "if_not_exists": true,
                "retention": {
                  "max_age_secs": 3600,
                  "min_count": 10
                }
              }
            },
            {
              "family": "function",
              "variant": "create_function",
              "description": "register function opts_f from exact source \"fn opts_f() {}\" with replace true, public visibility and now optimization; hmac excluded",
              "args": {
                "create_function": "opts_f",
                "source": "fn opts_f() {}",
                "replace": true,
                "visibility": "public",
                "optimize": "now"
              }
            },
            {
              "family": "schema",
              "variant": "set_table_schema",
              "description": "replace schema of table opts_t with expected schema version 7, repo main",
              "args": {
                "set_table_schema": "opts_t",
                "repo": "main",
                "expected_version": 7
              }
            },
            {
              "family": "validator",
              "variant": "bind_validator",
              "description": "bind validator opts_v to table opts_t of db for delete and upsert operations at priority 2000, repo main",
              "args": {
                "bind_validator": "opts_v",
                "db": "db",
                "table": "opts_t",
                "repo": "main",
                "ops": [
                  "delete",
                  "upsert"
                ],
                "priority": 2000
              }
            },
            {
              "family": "table",
              "variant": "drop_table",
              "description": "drop table opts_t with if_exists and cascade false, repo main; hmac excluded",
              "args": {
                "drop_table": "opts_t",
                "repo": "main"
              }
            }
          ],
          "expected_canonical_bytes_hex": "",
          "expected_checksum_hex": "b2968119a401717867a115075c3e4c10ac25f0c39b7563fa58cad07d0d4f25b6"
